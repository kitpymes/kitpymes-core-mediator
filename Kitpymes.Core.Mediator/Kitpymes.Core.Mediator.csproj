<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(KitpymesRoot)docs/props/Common.Build.props" Condition="Exists('$(KitpymesRoot)docs/props/Common.Build.props')" />
  <Import Project="$(KitpymesRoot)docs/props/Pack.Build.props" Condition="Exists('$(KitpymesRoot)docs/props/Pack.Build.props')" />

  <PropertyGroup>
    <Title>Kitpymes.Core.Mediator</Title>
    <Description>Mediador Kitpymes: comandos y consultas separados, notificaciones y comportamientos, siempre con resultados Result. Captura lo inesperado, lo registra sin el contenido de la petición y lo devuelve como Result de error. Comprueba la configuración al arrancar.</Description>
    <PackageTags>Mediator, Mediador, CQRS, Command, Query, Notification, Pipeline, Kitpymes</PackageTags>
  </PropertyGroup>

  <!-- Sirve también fuera de ASP.NET Core (consola, worker): sólo las abstracciones de Microsoft.Extensions. -->
  <ItemGroup>
    <FrameworkReference Remove="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- PrivateAssets="none": el analizador KPY0003 de Results llega a través de Abstractions. -->
    <ProjectReference Include="$(KitpymesRoot)Kitpymes.Core.Mediator.Abstractions\Kitpymes.Core.Mediator.Abstractions.csproj" PrivateAssets="none" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
