<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="$(KitpymesRoot)docs/props/Common.Build.props" Condition="Exists('$(KitpymesRoot)docs/props/Common.Build.props')" />

  <!--
    Prueba de que los analizadores de Common.Build.props se ejecutan: no está en Solution.sln ni se empaqueta.
    La pipeline lo compila tal cual (tiene que compilar) y con -p:DescarteOlvidado=true (tiene que fallar con VSTHRD110,
    también sin avisos como errores).
    El nombre no lleva "Tests" para que Common.Build.props le aplique los analizadores como a una librería.
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Propiedad propia y no DefineConstants en la línea de comandos, que borraría DEBUG, TRACE y las del SDK. -->
  <PropertyGroup Condition=" '$(DescarteOlvidado)' == 'true' ">
    <DefineConstants>$(DefineConstants);DESCARTE_OLVIDADO</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Remove="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
